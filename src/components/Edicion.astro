---
interface Props {
	title: string;
	desc: string;
    images: number;
    href: string
    images_path: string
    date: string
    image_type?: string
    title_image_path?: string
}

const { title, desc, images, href, images_path, date, image_type = 'webp', title_image_path } = Astro.props;

import { Icon } from 'astro-icon/components'

import { Image } from 'astro:assets';
---

<div class="w-full flex flex-col justify-start items-start shrink gap-4 px-12 py-20 pt-14 md:px-24 md:py-12 md:pr-12 relative overflow-hidden">
    <Image class="absolute left-0 top-0 w-full h-full" width={1} height={1} src="/assets/images/backgrounds/black-paper.webp" alt="fondo de cine fondodecine background paper black paper"/>

    <p class="hidden sm:block absolute text-nowrap left-[10%] top-[10%] text-lg text-neutral-200 tracking-wide font-xtypewriter">{date}</p>
    <!-- <a class="flex flex-col items-center justify-between transition-all hover:pl-2 cursor-pointer pb-1" href={href}>
        <div class="flex items-center gap-1 w-full">
            <h1 class="text-2xl flex items-center gap-1 font-gliker sm:text-nowrap">{title}</h1>
            <Icon name="tabler:external-link"/>
        </div>
        <h1 class="w-full text-xl font-gliker">{date}</h1>
    </a> -->

    <div class="w-full flex justify-center items-center0">
        <Image class="w-[75%] md:w-[30%] object-cover" width={1} height={1} src={title_image_path} alt=""/>
    </div>

    <div class="w-full h-full flex-1 flex flex-col sm:flex-row gap-6">
        <div class="w-full flex items-center">
            <div
                class="w-full aspect-video"

                x-data="{ image_index: 0, timeout: null }"
                x-init="timeout = setInterval(() => image_index++, 1200)"
                x-on:click="image_index++; clearTimeout(timeout); timeout = setTimeout(() => image_index++, 1200)"
                x-effect=`if (image_index >= ${images}) image_index = 0`
            >
                {Array.from(Array(images).keys()).map(index => (
                    <img
                        class="w-full h-full aspect-video object-cover absolute left-0 top-0 cursor-pointer shadow"

                        x-data=`{image: ${index}}`
                        x-show="image_index == image"
                        x-on:error="image_index = 0"
                        x-bind:src=`'${images_path}${index}.${image_type}'`
                        x-transition.opacity.duration.600ms

                        loading="lazy"
                        decoding="async"
                    >
                ))}
            </div>
        </div>

        <p class="md:hidden text-center w-full text-base text-neutral-200 tracking-wide font-xtypewriter">{date}</p>

        <div class="text-neutral-200 tracking-wide w-full flex flex-col gap-4 md:gap-2 justify-start items-center sm:items-start">
            <p class="2xl:text-2xl font-xtypewriter">
                {desc}
            </p>
            <a class="font-xtypewriter w-full sm:w-fit text-center text-lg sm:text-sm border border-neutral-500 px-2 py-1 sm:py-[0.5px] hover:translate-x-2 md:opacity-50 hover:opacity-100 transition-all" href={href}>Ver mas...</a>
        </div>
    </div>
</div>