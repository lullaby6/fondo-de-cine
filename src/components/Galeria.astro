---
interface Props {
	className?: string;
	id: string;
	title: string;
	images: number;
	images_path: string
	image_type?: string
}

import { Icon } from 'astro-icon/components'

const { className, id, title, images, images_path, image_type = 'webp' } = Astro.props;

import Section from '@/layouts/Section.astro';
---

<Section
	className={`bg-transparent pb-10 ${className}`}
	id={id}
	title={title}
>
	<div 
		x-data=`{ 
			modal: false, 
			images_path: ${JSON.stringify(images_path)},
			images_count: ${images}, 
			image_type: '${image_type}', 
			image_index: 0,
			image_transition_duration: 300	 
		}`
		@change="$refs.image.animate([{ opacity: 1 }, { opacity: 0.25 }, { opacity: 1 }],{ duration: image_transition_duration, ease: 'ease-in-out', fill: 'forwards' });"
		@prev="setTimeout(() => {image_index = (image_index - 1 + images_count) % images_count}, (image_transition_duration/2)); $dispatch('change')"
		@next="setTimeout(() => {image_index = (image_index + 1 + images_count) % images_count}, (image_transition_duration/2)); $dispatch('change')"
		@keydown.window="if (event.key === 'Escape') modal = false; else if (event.key === 'ArrowLeft') $dispatch('prev'); else if (event.key === 'ArrowRight') $dispatch('next');"
		@swipe-left.window="$dispatch('prev')"
		@swipe-right.window="$dispatch('next')"
	>
		<div
			class="w-screen h-screen fixed top-0 left-0 bg-black bg-opacity-75 z-20 flex justify-center items-center"

			x-show="modal"
			x-transition.opacity.duration.600ms
			x-on:click="modal = false"
		>
			<img
				class="w-3/4 sm:w-1/2"
				x-ref="image"
				x-on:error="modal = false"
				x-bind:src="`${images_path}${image_index}.${image_type}`"
				x-transition.opacity.duration.600ms

				alt="festi fondo de cine indie independiente galeria imagen cortos buenos aires argentina"

				loading="lazy"
				decoding="async"
			/>

			<button
				x-on:click.stop="$dispatch('prev')"
				class="absolute top-1/2 left-0 sm:left-10 -translate-y-1/2 z-100 text-white text-3xl md:text-4xl opacity-50 hover:opacity-100 cursor-pointer transition-opacity"
			><Icon class="text" name="grommet-icons:previous"/></button>
			<button 
				x-on:click.stop="$dispatch('next')"
				class="absolute top-1/2 right-0 sm:right-10 -translate-y-1/2 z-100 text-white text-3xl md:text-4xl opacity-50 hover:opacity-100 cursor-pointer transition-opacity"
			><Icon class="text" name="grommet-icons:next"/></button>
		</div>

		<div class="w-full columns-2 sm:columns-4 gap-x-4">
			{Array.from(Array(images).keys()).map(i => i).map(index => (	
				<div 
					id={`${id}-${index}`}
					class="bg-cover bg-center bg-black bg-opacity-50 w-full"
					x-init="ScrollReveal().reveal($el, { duration: 1000, ease: 'ease-in-out', distance: '25%', origin: 'bottom' })"
				>
				<img
					class="w-full object-cover cursor-pointer shadow mb-4 transition-transform hover:scale-[1.05] animate-fade"

					x-on:error="event.target.remove()"
					x-on:click=`modal = true; image_index = ${index}`
					x-bind:src=`'${images_path}${index}.${image_type}'`

					alt="festi fondo de cine indie independiente galeria imagen cortos buenos aires argentina"

					loading="lazy"
					decoding="async"
				>
				</div>
			))}
		</div>

		<slot name="footer"/>
	</div>
</Section>