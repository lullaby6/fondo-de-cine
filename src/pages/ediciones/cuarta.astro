---
import { Image } from "astro:assets";

import Layout from "@/layouts/Layout.astro";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import Galeria from "@/components/Galeria.astro";
---

<Layout title="FONDO DE CINE - Cuarta edición">
	<Header>
		<a
			class="text-nowrap text-neutral-200 opacity-75 transition-opacity hover:opacity-100 hover:underline cursor-pointer"
			href="/.">
			INICIO
		</a>
		<a
			class="text-nowrap text-neutral-200 opacity-75 transition-opacity hover:opacity-100 hover:underline cursor-pointer"
			href="#cortos">
			CORTOS
		</a>
		<a
			class="text-nowrap text-neutral-200 opacity-75 transition-opacity hover:opacity-100 hover:underline cursor-pointer"
			href="#galeria">
			GALERÍA
		</a>
	</Header>

	<main class="w-full min-h-screen flex flex-col px-10 sm:px-36 pt-20">
		<Image
			class="w-screen h-screen fixed left-0 top-0 object-cover"
			src="/assets/images/backgrounds/paper.webp"
			width={1}
			height={1}
			alt=""
		/>
		<div
			class="w-screen h-screen fixed left-0 top-0 bg-black bg-opacity-20">
		</div>

		<Galeria
			id="cortos"
			title="CORTOS"
			images={10}
			images_path="/assets/images/ediciones/cuarta/cortos/"
		/>
		<Galeria
			id="galeria"
			title="GALERIA"
			images={32}
			image_type="webp"
			images_path="/assets/images/ediciones/cuarta/">
			<p slot="footer" class="italic w-full text-end">
				Fotos por Camila Yucra Cabello.
			</p>
		</Galeria>
	</main>

	<Footer />
</Layout>
