---
import Section from '@/layouts/Section.astro';
---

<Section id='apoyar' title="APOYAR " className="font-xtypewriter px-10 md:px-36 pt-20 !pb-20 !min-h-0 relative overflow-hidden">
    <img class="absolute bottom-0 translate-y-[50%] xl:translate-y-0 translate-x-[25%] xl:translate-x-0 xl:top-0 right-0 xl:right-[300px] z-10 w-[150px] xl:w-[300px]" src="/assets/images/forms/2.webp" alt="festi fondo de cine indie independiente galeria imagen cortos buenos aires argentina" loading="lazy" decoding="async" />

    <div class="flex flex-col items-center md:items-start text-center md:text-left gap-2 border-y border-neutral-400 py-6">
        <div class="flex flex-col gap-1">
            <p class="text-xl drop-shadow-outline-white">¿Queres ayudar a nuestro Festi?</p>
            <p class="text-xl drop-shadow-outline-white">¡Podes hacerlo con una pequeña donación!</p>
        </div>
        <div class="flex justify-center items-center gap-1 w-fit text-lg">
            <p class="drop-shadow-outline-white">Alias:</p>
            <p class="flex justify-center items-center px-1.5 py-0.5 border border-neutral-300 rounded-full bg-neutral-200">fondo.de.cine</p>
        </div>
    </div>
</Section>