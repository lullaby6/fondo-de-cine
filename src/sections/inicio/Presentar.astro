---
import { Image } from 'astro:assets';

const link = "https://docs.google.com/forms/d/e/1FAIpQLSelrK30ln5TpW2BqZI-mtaRdnUzquEiAIPON9NHslIsSpMb5w/viewform"
---

<section id="presentar" class="h-screen w-screen overflow-hidden flex justify-start items-center gap-8 px-36">
    <img scroll-screen-display class="w-screen h-screen fixed left-0 top-0 object-cover -z-10" src="/assets/images/backgrounds/forms.webp" alt=""/>

    <div class="font-great-warrior text-lg sm:text-3xl 2xl:text-4xl w-full h-full flex flex-col gap-4 justify-center items-center text-neutral-900">
        <div class="flex gap-4">
            <a target="_blank" href={link} class="px-8 py-4 sm:px-10 sm:py-5 bg-neutral-900 text-neutral-200 shadow-xl transition-transform hover:scale-[1.125] hover:z-10" href="#presentar">¿QUERES</a>
            <a target="_blank" href={link} class="px-8 py-4 sm:px-10 sm:py-5 bg-neutral-900 text-neutral-200 shadow-xl transition-transform hover:scale-[1.125] hover:z-10" href="#presentar">PROYECTAR</a>
        </div>
        <div class="flex gap-4">
            <a target="_blank" href={link} class="px-8 py-4 sm:px-10 sm:py-5 bg-neutral-900 text-neutral-200 shadow-xl transition-transform hover:scale-[1.125] hover:z-10" href="#presentar">TU</a>
            <a target="_blank" href={link} class="px-8 py-4 sm:px-10 sm:py-5 bg-neutral-200 shadow-xl transition-transform hover:scale-[1.125] hover:z-10" href="#presentar">CORTO</a>
            <a target="_blank" href={link} class="px-8 py-4 sm:px-10 sm:py-5 bg-neutral-900 text-neutral-200 shadow-xl transition-transform hover:scale-[1.125] hover:z-10" href="#presentar">EN</a>
        </div>
        <div class="flex gap-4">
            <a target="_blank" href={link} class="px-8 py-4 sm:px-10 sm:py-5 bg-neutral-900 text-neutral-200 shadow-xl transition-transform hover:scale-[1.125] hover:z-10" href="#presentar">NUESTRO</a>
            <a target="_blank" href={link} class="px-8 py-4 sm:px-10 sm:py-5 bg-neutral-900 text-neutral-200 shadow-xl transition-transform hover:scale-[1.125] hover:z-10" href="#presentar">FESTI?</a>
        </div>
    </div>
</section>